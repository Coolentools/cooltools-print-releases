# pi-gen configuratie voor een kant-en-klaar Print Bridge SD-image.
# Gebruikt door build.sh (Docker). Pas TARGET_HOSTNAME / eerste gebruiker aan.
IMG_NAME="printbridge"
RELEASE="bookworm"
DEPLOY_COMPRESSION="xz"
DEPLOY_ZIP=0
# Lite (geen desktop) + onze eigen stage erachter. Relatieve naam: de stage staat
# in de pi-gen-root (door build.sh/CI erheen gekopieerd). NIET ${BASE_DIR}
# gebruiken — die is nog niet gezet als pi-gen de config sourcet (set -u → fout).
STAGE_LIST="stage0 stage1 stage2 stage-printbridge"
TARGET_HOSTNAME="cooltools-print"
ENABLE_SSH=1
LOCALE_DEFAULT="nl_NL.UTF-8"
KEYBOARD_KEYMAP="us"
TIMEZONE_DEFAULT="Europe/Amsterdam"
# Standaard eerste gebruiker (wijzig vóór distributie!). Deze gebruiker krijgt op
# Raspberry Pi OS automatisch passwordless sudo, wat de auto-install nodig heeft.
FIRST_USER_NAME="cooltools"
FIRST_USER_PASS="changeme"
DISABLE_FIRST_BOOT_USER_RENAME=1
